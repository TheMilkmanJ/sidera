{
  "manifest_version": 3,
  "name": "Sidera Dual-Hemisphere Mediator",
  "version": "1.0.0",
  "key": "",
  "description": "Local browser bridge and turn-taking mediator between ChatGPT and Gemini.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "nativeMessaging",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://x.com/*",
    "https://grok.com/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sidera Mediator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://x.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "dom_utils.js",
        "completion.js",
        "adapters/chatgpt.js",
        "adapters/gemini.js",
        "adapters/grok.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
