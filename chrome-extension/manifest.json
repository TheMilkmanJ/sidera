{
  "manifest_version": 3,
  "name": "Sidera Dual-Hemisphere Mediator",
  "version": "1.0.0",
  "key": "",
  "description": "Local mediator between two browser sessions the operator chooses. LEFT and RIGHT keep different roles.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "nativeMessaging",
    "debugger",
    "windows"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://accounts.x.ai/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sidera Mediator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://accounts.x.ai/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dom_utils.js",
        "completion.js",
        "session.js",
        "adapters/chatgpt.js",
        "adapters/gemini.js",
        "adapters/grok.js",
        "adapters/claude.js",
        "adapters/browser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
